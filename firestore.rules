rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Authentication and RBAC helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isTeacher() {
      return isSignedIn() && (
        request.auth.token.email == 'khafidmaulana1306@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')
      );
    }

    // User profile validation
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 255
        && data.role in ['teacher', 'student'];
    }

    // Passage validation
    function isValidPassage(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 255
        && data.content is string && data.content.size() > 0 && data.content.size() <= 10000
        && data.category is string && data.category.size() <= 100
        && data.status in ['published', 'draft'];
    }

    // Question validation
    function isValidQuestion(data) {
      return data.question is string && data.question.size() > 0 && data.question.size() <= 2000
        && data.options is map
        && data.correctAnswer in ['A', 'B', 'C', 'D', 'E']
        && data.category is string && data.category.size() <= 100
        && data.difficulty in ['mudah', 'sedang', 'sulit', 'Mudah', 'Sedang', 'Sulit']
        && data.status in ['published', 'draft'];
    }

    // Quiz Result validation
    function isValidQuizResult(data) {
      return data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 128
        && data.totalQuestions is number && data.totalQuestions >= 0 && data.totalQuestions <= 200
        && data.correctAnswers is number && data.correctAnswers >= 0 && data.correctAnswers <= 200
        && data.wrongAnswers is number && data.wrongAnswers >= 0 && data.wrongAnswers <= 200
        && data.score is number && data.score >= 0
        && data.percentage is number && data.percentage >= 0 && data.percentage <= 100;
    }

    // Users collection (RBAC)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isTeacher());
      allow list: if isTeacher();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSignedIn() && (request.auth.uid == userId || isTeacher()) && isValidUserProfile(incoming());
      allow delete: if isTeacher();
    }

    // Passages collection (Teacher writes, authenticated users read)
    match /passages/{passageId} {
      allow get, list: if isSignedIn();
      allow create: if isTeacher() && isValidId(passageId) && isValidPassage(incoming());
      allow update: if isTeacher() && isValidId(passageId) && isValidPassage(incoming());
      allow delete: if isTeacher() && isValidId(passageId);
    }

    // Questions collection (Teacher writes, authenticated users read)
    match /questions/{questionId} {
      allow get, list: if isSignedIn();
      allow create: if isTeacher() && isValidId(questionId) && isValidQuestion(incoming());
      allow update: if isTeacher() && isValidId(questionId) && isValidQuestion(incoming());
      allow delete: if isTeacher() && isValidId(questionId);
    }

    // Quiz Results collection (Students can submit and view their own, Teachers view/manage all)
    match /quiz_results/{resultId} {
      allow get: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid ||
        isTeacher()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(resultId) && isValidQuizResult(incoming());
      allow update: if isTeacher() && isValidId(resultId) && isValidQuizResult(incoming());
      allow delete: if isTeacher() && isValidId(resultId);
    }
  }
}
